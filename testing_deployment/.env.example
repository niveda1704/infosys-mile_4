# ============================================================================
# SwipeX shared configuration.  Copy to `.env` in this folder (next to this file).
# Every backend service, the gateway and the AI service read this one file.
# ============================================================================

# --- ONE PostgreSQL database for everything (auth, jobs, resumes, notifications, AI) ---
# Create it once:  CREATE DATABASE swipex;   (or run:  python scripts/init_db.py)
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/swipex

# --- JWT: must be the SAME value for the gateway, auth, job and resume services ---
JWT_SECRET_KEY=change-me-in-production
SECRET_KEY=change-me-too

# --- Service addresses (gateway -> services). Only the gateway is public. ---
GATEWAY_PORT=5000
AUTH_SERVICE_URL=http://127.0.0.1:5001
JOB_SERVICE_URL=http://127.0.0.1:5002
RESUME_SERVICE_URL=http://127.0.0.1:5003
AI_SERVICE_URL=http://127.0.0.1:8000

# --- Frontend origins allowed by the gateway (comma separated) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# --- AI: embedding model for semantic matching ---
# sentence-transformers model name. If it cannot be loaded the AI service falls back to a
# lexical hashing-vector model (still vector search, but not semantic) and says so in /health.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Set to 1 to skip the neural model entirely (fast start, lexical vectors only)
EMBEDDING_FORCE_FALLBACK=0

# --- Optional Google OAuth (auth-service) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional: shared secret between the gateway/services and the AI service ---
# When set, the AI service rejects any request that lacks the matching X-Internal-Key header.
INTERNAL_API_KEY=

# ---- Docker / deployment (docker-compose.yml) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=swipex
# URL the BROWSER uses to reach the gateway (baked into the frontend build)
PUBLIC_API_URL=http://localhost:5000/api/v1

# ---- Milestone 4: security (gateway) ----
RATE_LIMIT_ENABLED=1
RATE_LIMIT_AUTH_PER_MIN=20        # login / register / password reset, per client IP
RATE_LIMIT_AI_PER_MIN=120
RATE_LIMIT_GENERAL_PER_MIN=300
TRUST_PROXY=0                     # set 1 only behind a reverse proxy you control (reads X-Forwarded-For)

# ---- Milestone 4: competition indicators (job-service) ----
COMP_HIGH_COUNT=15
COMP_HIGH_VELOCITY=6              # applicants per day
COMP_MEDIUM_COUNT=5
COMP_MEDIUM_VELOCITY=2
EARLY_WINDOW_HOURS=48

# ---- Milestone 4: alert delivery (job-service) ----
EMAIL_BACKEND=console             # console = log emails only | smtp = really send
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@swipex.local
SMTP_TLS=1
# Push (FCM) is only a hook: both must be set for the app to *report* push as configured; sending is not implemented
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
