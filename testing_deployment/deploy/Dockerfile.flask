# One image recipe for the three Flask services and the gateway.
#   docker build -f deploy/Dockerfile.flask --build-arg SERVICE_DIR=backend_jayashree/services/job-service \
#                --build-arg APP_MODULE=run:app -t swipex-job .
FROM python:3.12-slim
ARG SERVICE_DIR
ARG APP_MODULE=run:app
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 APP_MODULE=${APP_MODULE} PORT=5000
WORKDIR /app
COPY ${SERVICE_DIR}/requirements.txt ./requirements.txt
RUN pip install -r requirements.txt gunicorn
COPY ${SERVICE_DIR}/ ./
RUN useradd -r -u 10001 swipex && mkdir -p /app/uploads /app/instance && chown -R swipex /app
USER swipex
EXPOSE 5000
# secrets come from the environment at run time - nothing is baked into the image
CMD ["sh", "-c", "exec gunicorn --bind 0.0.0.0:${PORT} --workers ${WEB_CONCURRENCY:-2} --timeout 120 ${APP_MODULE}"]
