FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PORT=8000 HF_HOME=/models
WORKDIR /app
COPY artificial_intelligence_meghana/requirements.txt ./requirements.txt
# CPU-only torch keeps the image small enough for free tiers
RUN pip install torch --index-url https://download.pytorch.org/whl/cpu && pip install -r requirements.txt
COPY artificial_intelligence_meghana/ ./
RUN useradd -r -u 10001 swipex && mkdir -p /models && chown -R swipex /app /models
USER swipex
EXPOSE 8000
CMD ["sh", "-c", "exec uvicorn src.main:app --host 0.0.0.0 --port ${PORT}"]
