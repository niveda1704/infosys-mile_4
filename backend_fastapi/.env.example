APP_NAME=SwipeX
ENVIRONMENT=dev
DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://swipex:swipex@localhost:5432/swipex
TEST_DATABASE_URL=postgresql+asyncpg://swipex:swipex@localhost:5433/swipex_test
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

REDIS_URL=redis://localhost:6379/0

SECRET_KEY=dev-only-change-me-please-32-chars-min-xxxxx
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ALLOW_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
# Hostnames (not URLs), comma separated. Used by TrustedHostMiddleware outside dev. Empty = off.
ALLOWED_HOSTS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./var/storage
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=swipex-resumes
MINIO_SECURE=false
MAX_RESUME_SIZE_MB=5

AI_MODE=local
AI_SERVICE_BASE_URL=
AI_SERVICE_TIMEOUT_SECONDS=5
# Sent as X-Internal-Api-Key to the AI service (must match its INTERNAL_API_KEY)
AI_SERVICE_API_KEY=

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@swipex.local
# Hosted SMTP (SendGrid/Brevo/...): SMTP_START_TLS=true with port 587, or SMTP_USE_TLS=true with 465
SMTP_USE_TLS=false
SMTP_START_TLS=false
EMAIL_BACKEND=console

PUSH_BACKEND=noop
FCM_CREDENTIALS_JSON_PATH=

RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute

COMPETITION_LOW_MAX=20
COMPETITION_MEDIUM_MAX=100
EARLY_APPLICANT_WINDOW_HOURS=48
FRESH_JOB_DAYS=7
MAX_ALERTS_PER_DAY=20

SEED_ON_STARTUP=false
# Seeding creates demo users with known passwords; blocked in production unless this is true
ALLOW_PRODUCTION_SEED=false